        }
      }
    },
    "+100 points for each suit you complete from Ace to King." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "+100 Punkte für jede Farbe, die Sie vom Ass bis zum König vervollständigen."
