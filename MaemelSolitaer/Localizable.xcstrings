        }
      }
    },
    "+25 points when a King moves into an empty column." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "+25 Punkte, wenn ein König in eine leere Spalte gelegt wird."
          }
        }
      }
    },
    "+40 points every time you empty a column." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "+40 Punkte jedes Mal, wenn Sie eine Spalte leeren."
