        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legen Sie die Karten in den Spalten absteigend und abwechselnd in Rot und Schwarz an – zum Beispiel eine rote 6 auf eine schwarze 7. In eine leere Spalte darf nur ein König gelegt werden."
          }
        }
      }
    },
