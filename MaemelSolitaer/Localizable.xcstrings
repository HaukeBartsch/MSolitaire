    },
    "Difficulty" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schwierigkeitsgrad"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fertig"
          }
        }
      }
    },
    "Each chapter has three rounds: Warm-Up, Main and Boss. Reach the target score to clear a round. There is no timer — take all the time you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes Kapitel besteht aus drei Runden: Aufwärmrunde, Hauptrunde und Bossrunde. Erreichen Sie die Zielpunktzahl, um eine Runde zu schaffen. Es gibt keine Zeitbegrenzung – lassen Sie sich so viel Zeit, wie Sie möchten."
          }
        }
      }
    },
    "Each Hint costs 10 points this round." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeder „Tipp“ kostet in dieser Runde 10 Punkte."
          }
        }
      }
    },
    "Each Undo costs 15 points this round." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes „Zurück“ kostet in dieser Runde 15 Punkte."
          }
        }
      }
    },
    "Earn 50 extra points each time you empty a column." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sie erhalten 50 Extrapunkte jedes Mal, wenn Sie eine Spalte leeren."
          }
        }
      }
    },
    "Easy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leicht"
          }
        }
      }
    },
    "Easy is the classic game. Medium adds an eighth column. Hard uses two decks, nine columns and eight foundation piles, and always turns over 3 deck cards at a time. Every deal is checked in advance so it can always be won." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Leicht“ ist das klassische Spiel. „Mittel“ fügt eine achte Spalte hinzu. „Schwer“ wird mit zwei Kartenspielen, neun Spalten und acht Zielstapeln gespielt, und vom Nachziehstapel werden immer 3 Karten auf einmal aufgedeckt. Jede Kartenverteilung wird vorab geprüft, damit sie sich immer lösen lässt."
          }
        }
      }
    },
    "Easy is the classic game. Medium adds an eighth column. Hard uses two decks, nine columns and eight foundation piles. Every deal is checked in advance so it can always be won." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Leicht“ ist das klassische Spiel. „Mittel“ fügt eine achte Spalte hinzu. „Schwer“ wird mit zwei Kartenspielen, neun Spalten und acht Zielstapeln gespielt. Jede Kartenverteilung wird vorab geprüft, damit sie sich immer lösen lässt."
          }
        }
      }
    },
