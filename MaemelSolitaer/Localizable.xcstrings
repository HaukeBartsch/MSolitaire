    "+10 points for every card moved to the foundation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "+10 Punkte für jede Karte, die auf einen Zielstapel gelegt wird."
          }
        }
      }
    },
    "+10 points for every deck card played onto a column." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "+10 Punkte für jede Karte vom Nachziehstapel, die auf eine Spalte gelegt wird."
          }
        }
      }
    },
    "+10 points for every face-down card you turn over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "+10 Punkte für jede verdeckte Karte, die Sie aufdecken."
